@model ThreeDManager.Domain.Entities.PrintJob
@using ThreeDManager.Domain.Entities
@using ThreeDManager.Web.Presentation

@{
    ViewData["Title"] = "Detalhes da produção";
    var stockMovement = ViewBag.StockMovement as MaterialStockMovement;
    var productStockMovement = ViewBag.ProductStockMovement as ProductStockMovement;
    var returnTo = ViewData["ReturnTo"] as string;
    var filterPrinterId = ViewData["ReturnPrinterId"] as Guid?;
    var materialCostPerKg = ViewBag.MaterialCostPerKg as decimal?;
    var printerCostPerHour = ViewBag.PrinterCostPerHour as decimal?;
    var productSalePrice = ViewBag.ProductSalePrice as decimal?;
    var productTargetMarginPercentage = ViewBag.ProductTargetMarginPercentage as decimal?;
    var machineTimeMinutes = Model.ActualTimeMinutes ?? Model.EstimatedTimeMinutes;
    decimal? estimatedMachineCost = (printerCostPerHour.HasValue && machineTimeMinutes.HasValue)
        ? Math.Round((machineTimeMinutes.Value / 60m) * printerCostPerHour.Value, 2)
        : (decimal?)null;
    decimal? estimatedTotalProductionCost = (Model.CalculatedMaterialCost.HasValue && estimatedMachineCost.HasValue)
        ? Model.CalculatedMaterialCost.Value + estimatedMachineCost.Value + (Model.PackagingCost ?? 0m)
        : (decimal?)null;
    decimal? estimatedMargin = (productSalePrice.HasValue && estimatedTotalProductionCost.HasValue)
        ? productSalePrice.Value - estimatedTotalProductionCost.Value
        : (decimal?)null;
    decimal? estimatedMarginPercentage = (estimatedMargin.HasValue && productSalePrice > 0m)
        ? Math.Round((estimatedMargin.Value / productSalePrice.Value) * 100m, 1)
        : (decimal?)null;
    decimal? suggestedSalePrice = (estimatedTotalProductionCost.HasValue && productTargetMarginPercentage.HasValue)
        ? Math.Round(estimatedTotalProductionCost.Value * (1 + (productTargetMarginPercentage.Value / 100m)), 2)
        : (decimal?)null;
}

<h1>Detalhes da produção</h1>

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            <dt class="col-sm-3">Produto</dt>
            <dd class="col-sm-9">@ViewBag.ProductName</dd>

            <dt class="col-sm-3">Material</dt>
            <dd class="col-sm-9">@ViewBag.MaterialName</dd>

            <dt class="col-sm-3">Impressora</dt>
            <dd class="col-sm-9">@ViewBag.PrinterName</dd>

            <dt class="col-sm-3">Arquivo origem</dt>
            <dd class="col-sm-9">@Model.SourceFileName</dd>

            <dt class="col-sm-3">Filamento usado</dt>
            <dd class="col-sm-9">
                @if (Model.FilamentUsedGrams.HasValue)
                {
                    <span>@Model.FilamentUsedGrams.Value.ToString("N2") g</span>
                }
                else
                {
                    <span class="text-muted">Não informado</span>
                }
            </dd>

            <dt class="col-sm-3">Filamento usado em metros</dt>
            <dd class="col-sm-9">
                @if (Model.FilamentUsedMeters.HasValue)
                {
                    <span>@Model.FilamentUsedMeters.Value.ToString("N2") m</span>
                }
                else
                {
                    <span class="text-muted">Não informado</span>
                }
            </dd>

            <dt class="col-sm-3">Tempo estimado</dt>
            <dd class="col-sm-9">
                @if (Model.EstimatedTimeMinutes.HasValue)
                {
                    <span>@Model.EstimatedTimeMinutes min</span>
                }
                else
                {
                    <span class="text-muted">Não informado</span>
                }
            </dd>

            <dt class="col-sm-3">Tempo real</dt>
            <dd class="col-sm-9">
                @if (Model.ActualTimeMinutes.HasValue)
                {
                    <span>@Model.ActualTimeMinutes min</span>
                }
                else
                {
                    <span class="text-muted">Não informado</span>
                }
            </dd>

            <dt class="col-sm-3">Custo informado</dt>
            <dd class="col-sm-9">
                @if (Model.ReportedCost.HasValue)
                {
                    @Model.ReportedCost.Value.ToString("C")
                }
                else
                {
                    <span class="text-muted">Não informado</span>
                }
            </dd>

            <dt class="col-sm-3">Custo de embalagem</dt>
            <dd class="col-sm-9">
                @if (Model.PackagingCost.HasValue)
                {
                    @Model.PackagingCost.Value.ToString("C")
                }
                else
                {
                    <span class="text-muted">Não informado</span>
                }
            </dd>

            <dt class="col-sm-3">Custo por grama do material</dt>
            <dd class="col-sm-9">
                @if (materialCostPerKg.HasValue)
                {
                    <span>@((materialCostPerKg.Value / 1000m).ToString("C4"))</span>
                }
                else
                {
                    <span class="text-muted">Não informado</span>
                }
            </dd>

            <dt class="col-sm-3">Custo calculado do material</dt>
            <dd class="col-sm-9">
                @if (Model.CalculatedMaterialCost.HasValue)
                {
                    @Model.CalculatedMaterialCost.Value.ToString("C")
                }
                else
                {
                    <span class="text-muted">Não calculado</span>
                }
            </dd>

            <dt class="col-sm-3">Custo por hora da impressora</dt>
            <dd class="col-sm-9">
                @if (printerCostPerHour.HasValue)
                {
                    <span>@printerCostPerHour.Value.ToString("C")</span>
                }
                else
                {
                    <span class="text-muted">Não informado</span>
                }
            </dd>

            <dt class="col-sm-3">Custo de máquina estimado</dt>
            <dd class="col-sm-9">
                @if (estimatedMachineCost.HasValue)
                {
                    <span>@estimatedMachineCost.Value.ToString("C")</span>
                    <small class="text-muted d-block">
                        @(Model.ActualTimeMinutes.HasValue ? "tempo real" : "tempo estimado"): @machineTimeMinutes min
                    </small>
                }
                else
                {
                    <span class="text-muted">Não disponível</span>
                }
            </dd>

            <dt class="col-sm-3">Custo total estimado da produção</dt>
            <dd class="col-sm-9">
                @if (Model.CalculatedMaterialCost.HasValue && estimatedMachineCost.HasValue)
                {
                    var materialCost = Model.CalculatedMaterialCost.Value;
                    var machineCost = estimatedMachineCost.Value;
                    var packagingCost = Model.PackagingCost ?? 0m;
                    <span>@((materialCost + machineCost + packagingCost).ToString("C"))</span>
                    <small class="text-muted d-block">
                        material @materialCost.ToString("C") + máquina @machineCost.ToString("C")@(Model.PackagingCost.HasValue ? $" + embalagem {Model.PackagingCost.Value.ToString("C")}" : string.Empty)
                    </small>
                }
                else
                {
                    <span class="text-muted">Não disponível</span>
                }
            </dd>

            <dt class="col-sm-3">Margem estimada</dt>
            <dd class="col-sm-9">
                @if (estimatedMargin.HasValue)
                {
                    var marginClass = estimatedMargin.Value > 0 ? "text-success" : estimatedMargin.Value < 0 ? "text-danger" : "text-muted";
                    var marginLabel = estimatedMargin.Value > 0 ? "lucro estimado" : estimatedMargin.Value < 0 ? "prejuízo estimado" : "sem margem";
                    <span class="@marginClass fw-semibold">
                        @estimatedMargin.Value.ToString("C")
                        @if (estimatedMarginPercentage.HasValue)
                        {
                            <span>(@estimatedMarginPercentage.Value.ToString("N1")%)</span>
                        }
                        — @marginLabel
                    </span>
                    <small class="text-muted d-block">
                        preço de venda @productSalePrice!.Value.ToString("C") − custo total estimado @estimatedTotalProductionCost!.Value.ToString("C")
                    </small>
                }
                else if (!productSalePrice.HasValue)
                {
                    <span class="text-muted">Produto sem preço de venda informado</span>
                }
                else
                {
                    <span class="text-muted">Não disponível</span>
                }
            </dd>

            <dt class="col-sm-3">Preço de venda sugerido</dt>
            <dd class="col-sm-9">
                @if (suggestedSalePrice.HasValue)
                {
                    <span class="fw-semibold">@suggestedSalePrice.Value.ToString("C")</span>
                    <small class="text-muted d-block">
                        custo total estimado @estimatedTotalProductionCost!.Value.ToString("C") + margem alvo @productTargetMarginPercentage!.Value.ToString("N1")%
                    </small>
                }
                else if (!productTargetMarginPercentage.HasValue)
                {
                    <span class="text-muted">Produto sem margem alvo informada</span>
                }
                else
                {
                    <span class="text-muted">Não disponível</span>
                }
            </dd>

            <dt class="col-sm-3">Diferença de custo</dt>
            <dd class="col-sm-9">
                @if (Model.ReportedCost.HasValue && Model.CalculatedMaterialCost.HasValue)
                {
                    var difference = Model.ReportedCost.Value - Model.CalculatedMaterialCost.Value;
                    var differenceClass = difference > 0 ? "text-danger" : difference < 0 ? "text-warning" : "text-muted";
                    var differenceLabel = difference > 0 ? "acima do calculado" : difference < 0 ? "abaixo do calculado" : "sem diferença";
                    <span class="@differenceClass">
                        @difference.ToString("C") — @differenceLabel
                    </span>
                }
                else
                {
                    <span class="text-muted">Não disponível</span>
                }
            </dd>

            <dt class="col-sm-3">Unidades produzidas</dt>
            <dd class="col-sm-9">@Model.UnitsProduced</dd>

            <dt class="col-sm-3">Baixa de estoque</dt>
            <dd class="col-sm-9">
                @if (Model.StockDeductedAt.HasValue && Model.StockDeductedGrams.HasValue)
                {
                    <span>@Model.StockDeductedGrams.Value.ToString("N2") g em @Model.StockDeductedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                }
                else
                {
                    <span class="text-muted">Não realizada</span>
                }
            </dd>

            <dt class="col-sm-3">Crédito de estoque do produto</dt>
            <dd class="col-sm-9">
                @if (Model.StockCreditedAt.HasValue && Model.StockCreditedUnits.HasValue)
                {
                    <span>@Model.StockCreditedUnits.Value un. em @Model.StockCreditedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                }
                else
                {
                    <span class="text-muted">Não realizado</span>
                }
            </dd>

            <dt class="col-sm-3">Status da produção</dt>
            <dd class="col-sm-9">
                <span class="badge @PrintJobStatusPresentation.GetBadgeClass(Model.Status)">
                    @PrintJobStatusPresentation.GetDisplayLabel(Model.Status)
                </span>
            </dd>

            <dt class="col-sm-3">Motivo da falha</dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrWhiteSpace(Model.FailureReason))
                {
                    <span>@Model.FailureReason</span>
                }
                else
                {
                    <span class="text-muted">Não informado</span>
                }
            </dd>

            <dt class="col-sm-3">Criado em</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
        </dl>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Movimentação de estoque vinculada</strong>
    </div>

    <div class="card-body">
        @if (stockMovement is null)
        {
            <div class="alert alert-info mb-0">
                Nenhuma movimentação de estoque registrada para esta produção.
            </div>
        }
        else
        {
            var movementLabel = stockMovement.MovementType switch
            {
                "PrintJobCompleted" => "Baixa automática",
                "PrintJobStockRestored" => "Devolução automática",
                "ManualAdjustment" => "Ajuste manual",
                _ => stockMovement.MovementType
            };

            <dl class="row mb-0">
                <dt class="col-sm-3">Tipo</dt>
                <dd class="col-sm-9">@movementLabel</dd>

                <dt class="col-sm-3">Quantidade</dt>
                <dd class="col-sm-9">
                    <span class="@(stockMovement.QuantityGrams < 0 ? "text-danger" : "text-success") fw-semibold">
                        @(stockMovement.QuantityGrams > 0 ? "+" : string.Empty)@stockMovement.QuantityGrams.ToString("N2") g
                    </span>
                </dd>

                <dt class="col-sm-3">Antes</dt>
                <dd class="col-sm-9">
                    @(stockMovement.StockBeforeGrams.HasValue ? $"{stockMovement.StockBeforeGrams.Value:N2} g" : "N/A")
                </dd>

                <dt class="col-sm-3">Depois</dt>
                <dd class="col-sm-9">
                    @(stockMovement.StockAfterGrams.HasValue ? $"{stockMovement.StockAfterGrams.Value:N2} g" : "N/A")
                </dd>

                <dt class="col-sm-3">Observações</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(stockMovement.Notes) ? "Sem observações" : stockMovement.Notes)</dd>
            </dl>
        }
    </div>
</div>

<div class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Movimentação de estoque de produto vinculada</strong>
    </div>

    <div class="card-body">
        @if (productStockMovement is null)
        {
            <div class="alert alert-info mb-0">
                Nenhuma movimentação de estoque de produto registrada para esta produção.
            </div>
        }
        else
        {
            var productMovementLabel = productStockMovement.MovementType switch
            {
                "PrintJobCompleted" => "Crédito automático",
                "PrintJobStockCreditReverted" => "Reversão automática",
                "ManualAdjustment" => "Ajuste manual",
                _ => productStockMovement.MovementType
            };

            <dl class="row mb-0">
                <dt class="col-sm-3">Tipo</dt>
                <dd class="col-sm-9">@productMovementLabel</dd>

                <dt class="col-sm-3">Quantidade</dt>
                <dd class="col-sm-9">
                    <span class="@(productStockMovement.QuantityUnits < 0 ? "text-danger" : "text-success") fw-semibold">
                        @(productStockMovement.QuantityUnits > 0 ? "+" : string.Empty)@productStockMovement.QuantityUnits un.
                    </span>
                </dd>

                <dt class="col-sm-3">Antes</dt>
                <dd class="col-sm-9">
                    @(productStockMovement.StockBeforeUnits.HasValue ? $"{productStockMovement.StockBeforeUnits.Value} un." : "N/A")
                </dd>

                <dt class="col-sm-3">Depois</dt>
                <dd class="col-sm-9">
                    @(productStockMovement.StockAfterUnits.HasValue ? $"{productStockMovement.StockAfterUnits.Value} un." : "N/A")
                </dd>

                <dt class="col-sm-3">Observações</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(productStockMovement.Notes) ? "Sem observações" : productStockMovement.Notes)</dd>
            </dl>
        }
    </div>
</div>

<div class="mt-3 d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" asp-route-returnTo="@returnTo" asp-route-filterPrinterId="@filterPrinterId" class="btn btn-primary">Editar</a>
    @if (returnTo == "errorQueue")
    {
        <a asp-controller="PrintImports" asp-action="Index" asp-route-status="error" class="btn btn-outline-secondary">Voltar para falhas</a>
    }
    else if (returnTo == "pendingQueue")
    {
        <a asp-controller="PrintImports" asp-action="Index" asp-route-productionState="pending" class="btn btn-outline-secondary">Voltar para pendentes</a>
    }
    else if (returnTo == "failedQueue")
    {
        <a asp-action="Index" asp-route-status="failed" asp-route-printerId="@filterPrinterId" class="btn btn-outline-secondary">Voltar para falhas</a>
    }
    else if (filterPrinterId.HasValue)
    {
        <a asp-action="Index" asp-route-printerId="@filterPrinterId" class="btn btn-outline-secondary">Voltar para produções desta impressora</a>
    }
    else
    {
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
    }

    @if (Model.PrintImportId.HasValue)
    {
        <a asp-controller="PrintImports"
           asp-action="Details"
           asp-route-id="@Model.PrintImportId"
           asp-route-returnTo="@returnTo"
           class="btn btn-outline-primary">
            Ver importação
        </a>
    }

    <a asp-action="Delete" asp-route-id="@Model.Id" asp-route-returnTo="@returnTo" asp-route-filterPrinterId="@filterPrinterId" class="btn btn-outline-danger">Remover</a>
</div>
