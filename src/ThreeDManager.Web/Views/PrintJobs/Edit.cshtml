@model ThreeDManager.Domain.Entities.PrintJob

@{
    ViewData["Title"] = "Editar produção";
    var returnTo = ViewData["ReturnTo"] as string;
}

<h1>Editar produção</h1>

<p class="text-muted">
    Ajuste os dados da produção, status, tempo real e vínculos.
</p>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="PrintImportId" />
    <input type="hidden" asp-for="SourceFileName" />
    <input type="hidden" asp-for="CreatedAt" />
    @if (!string.IsNullOrWhiteSpace(returnTo))
    {
        <input type="hidden" name="returnTo" value="@returnTo" />
    }

    <div class="mb-3">
        <label asp-for="ProductId" class="form-label">Produto</label>
        <select asp-for="ProductId" class="form-select" id="productSelect">
            <option value="">Selecione um produto</option>
            @{
                var productOptions = ViewBag.ProductOptions as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
                var productTargetMarginPercentageById = ViewBag.ProductTargetMarginPercentageById as IDictionary<string, decimal?>;
            }
            @if (productOptions is not null)
            {
                foreach (var option in productOptions)
                {
                    decimal? targetMarginPercentage = null;
                    if (productTargetMarginPercentageById is not null && productTargetMarginPercentageById.TryGetValue(option.Value, out var margin))
                    {
                        targetMarginPercentage = margin;
                    }
                    var targetMarginAttribute = targetMarginPercentage.HasValue
                        ? targetMarginPercentage.Value.ToString("0.0############################", System.Globalization.CultureInfo.InvariantCulture)
                        : string.Empty;
                    <option value="@option.Value" data-target-margin-percentage="@targetMarginAttribute">@option.Text</option>
                }
            }
        </select>
        <div class="form-text" id="productTargetMarginHint">Margem alvo do produto: <span>Não informada</span></div>
    </div>

    <div class="mb-3">
        <label asp-for="PrinterId" class="form-label">Impressora</label>
        <select asp-for="PrinterId" class="form-select" id="printerSelect">
            <option value="">Selecione uma impressora</option>
            @{
                var printerOptions = ViewBag.PrinterOptions as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
                var printerCostPerHourById = ViewBag.PrinterCostPerHourById as IDictionary<string, decimal?>;
            }
            @if (printerOptions is not null)
            {
                foreach (var option in printerOptions)
                {
                    decimal? costPerHour = null;
                    if (printerCostPerHourById is not null && printerCostPerHourById.TryGetValue(option.Value, out var cost))
                    {
                        costPerHour = cost;
                    }
                    var costAttribute = costPerHour.HasValue
                        ? costPerHour.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)
                        : string.Empty;
                    <option value="@option.Value" data-cost-per-hour="@costAttribute">@option.Text</option>
                }
            }
        </select>
        <div class="form-text" id="printerCostPerHourHint">Custo por hora da impressora: <span>Não informado</span></div>
    </div>

    <div class="mb-3">
        <label asp-for="MaterialId" class="form-label">Material</label>
        <select asp-for="MaterialId" class="form-select" id="materialSelect">
            <option value="">Selecione um material</option>
            @{
                var materialOptions = ViewBag.MaterialOptions as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
                var materialCostPerGramById = ViewBag.MaterialCostPerGramById as IDictionary<string, decimal?>;
            }
            @if (materialOptions is not null)
            {
                foreach (var option in materialOptions)
                {
                    decimal? costPerGram = null;
                    if (materialCostPerGramById is not null && materialCostPerGramById.TryGetValue(option.Value, out var cost))
                    {
                        costPerGram = cost;
                    }
                    var costAttribute = costPerGram.HasValue
                        ? costPerGram.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)
                        : string.Empty;
                    <option value="@option.Value" data-cost-per-gram="@costAttribute">@option.Text</option>
                }
            }
        </select>
        <div class="form-text" id="materialCostPerGramHint">Custo por grama do material: <span>Não informado</span></div>
    </div>

    <hr />

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="FilamentUsedGrams" class="form-label">Filamento usado (g)</label>
            <input asp-for="FilamentUsedGrams" class="form-control" type="number" step="0.01" id="filamentUsedGrams" />
            <div class="form-text" id="estimatedMaterialCostHint">Custo estimado do material: <span>Não informado</span></div>
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="FilamentUsedMeters" class="form-label">Filamento usado (m)</label>
            <input asp-for="FilamentUsedMeters" class="form-control" type="number" step="0.01" />
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="ReportedCost" class="form-label">Custo informado (R$)</label>
            <input asp-for="ReportedCost" class="form-control" type="number" step="0.01" />
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="PackagingCost" class="form-label">Custo de embalagem (R$)</label>
            <input asp-for="PackagingCost" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="PackagingCost" class="text-danger"></span>
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="EstimatedTimeMinutes" class="form-label">Tempo estimado (min)</label>
            <input asp-for="EstimatedTimeMinutes" class="form-control" type="number" id="estimatedTimeMinutes" />
            <div class="form-text" id="estimatedMachineCostHint">Custo de máquina estimado: <span>Não informado</span></div>
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="ActualTimeMinutes" class="form-label">Tempo real (min)</label>
            <input asp-for="ActualTimeMinutes" class="form-control" type="number" id="actualTimeMinutes" />
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="Status" class="form-label">Status da produção</label>
            <select asp-for="Status" asp-items="ViewBag.StatusOptions" class="form-select">
            </select>
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="UnitsProduced" class="form-label">Unidades produzidas</label>
            <input asp-for="UnitsProduced" class="form-control" type="number" />
            <span asp-validation-for="UnitsProduced" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="FailureReason" class="form-label">Motivo da falha</label>
        <textarea asp-for="FailureReason" class="form-control" rows="2" placeholder="Obrigatório ao marcar a produção como Falhou"></textarea>
        <span asp-validation-for="FailureReason" class="text-danger"></span>
    </div>

    <div class="alert alert-light border" id="estimatedTotalProductionCostHint">
        Custo total estimado da produção: <strong>Não informado</strong>
    </div>

    <div class="alert alert-light border" id="suggestedSalePriceHint">
        Preço de venda sugerido: <strong>Não informado</strong>
    </div>

    <div class="alert alert-light border">
        Arquivo origem: <strong>@Model.SourceFileName</strong>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Salvar alterações</button>
        <a asp-action="Details" asp-route-id="@Model.Id" asp-route-returnTo="@returnTo" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        (function () {
            var materialSelect = document.getElementById("materialSelect");
            var filamentUsedGrams = document.getElementById("filamentUsedGrams");
            var costPerGramHint = document.getElementById("materialCostPerGramHint");
            var estimatedCostHint = document.getElementById("estimatedMaterialCostHint");

            if (!materialSelect || !filamentUsedGrams || !costPerGramHint || !estimatedCostHint) {
                return;
            }

            var costPerGramValue = costPerGramHint.querySelector("span");
            var estimatedCostValue = estimatedCostHint.querySelector("span");

            function updateCostHints() {
                var selectedOption = materialSelect.options[materialSelect.selectedIndex];
                var raw = selectedOption ? selectedOption.getAttribute("data-cost-per-gram") : "";
                var costPerGram = raw ? parseFloat(raw) : NaN;
                var grams = filamentUsedGrams.value ? parseFloat(filamentUsedGrams.value) : NaN;

                if (isNaN(costPerGram)) {
                    costPerGramValue.textContent = "Não informado";
                    estimatedCostValue.textContent = "Não informado";
                    return;
                }

                costPerGramValue.textContent = "R$ " + costPerGram.toLocaleString("pt-BR", {
                    minimumFractionDigits: 4,
                    maximumFractionDigits: 4
                });

                estimatedCostValue.textContent = isNaN(grams)
                    ? "Não informado"
                    : "R$ " + (grams * costPerGram).toLocaleString("pt-BR", {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
            }

            materialSelect.addEventListener("change", updateCostHints);
            filamentUsedGrams.addEventListener("input", updateCostHints);
            updateCostHints();
        })();

        (function () {
            var printerSelect = document.getElementById("printerSelect");
            var estimatedTimeMinutes = document.getElementById("estimatedTimeMinutes");
            var actualTimeMinutes = document.getElementById("actualTimeMinutes");
            var costPerHourHint = document.getElementById("printerCostPerHourHint");
            var machineCostHint = document.getElementById("estimatedMachineCostHint");

            if (!printerSelect || !estimatedTimeMinutes || !actualTimeMinutes || !costPerHourHint || !machineCostHint) {
                return;
            }

            var costPerHourValue = costPerHourHint.querySelector("span");
            var machineCostValue = machineCostHint.querySelector("span");

            function updateMachineCostHints() {
                var selectedOption = printerSelect.options[printerSelect.selectedIndex];
                var raw = selectedOption ? selectedOption.getAttribute("data-cost-per-hour") : "";
                var costPerHour = raw ? parseFloat(raw) : NaN;

                var actual = actualTimeMinutes.value ? parseFloat(actualTimeMinutes.value) : NaN;
                var estimated = estimatedTimeMinutes.value ? parseFloat(estimatedTimeMinutes.value) : NaN;
                var usingActual = !isNaN(actual);
                var minutes = usingActual ? actual : estimated;

                if (isNaN(costPerHour)) {
                    costPerHourValue.textContent = "Não informado";
                    machineCostValue.textContent = "Não informado";
                    return;
                }

                costPerHourValue.textContent = "R$ " + costPerHour.toLocaleString("pt-BR", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });

                if (isNaN(minutes)) {
                    machineCostValue.textContent = "Não informado";
                    return;
                }

                var note = usingActual ? " (tempo real)" : " (tempo estimado)";
                machineCostValue.textContent = "R$ " + ((minutes / 60) * costPerHour).toLocaleString("pt-BR", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }) + note;
            }

            printerSelect.addEventListener("change", updateMachineCostHints);
            estimatedTimeMinutes.addEventListener("input", updateMachineCostHints);
            actualTimeMinutes.addEventListener("input", updateMachineCostHints);
            updateMachineCostHints();
        })();

        (function () {
            var productSelect = document.getElementById("productSelect");
            var materialSelect = document.getElementById("materialSelect");
            var printerSelect = document.getElementById("printerSelect");
            var filamentUsedGrams = document.getElementById("filamentUsedGrams");
            var estimatedTimeMinutes = document.getElementById("estimatedTimeMinutes");
            var actualTimeMinutes = document.getElementById("actualTimeMinutes");
            var packagingCost = document.getElementById("PackagingCost");
            var totalCostHint = document.getElementById("estimatedTotalProductionCostHint");
            var suggestedSalePriceHint = document.getElementById("suggestedSalePriceHint");
            var targetMarginHint = document.getElementById("productTargetMarginHint");

            if (!productSelect || !materialSelect || !printerSelect || !filamentUsedGrams || !estimatedTimeMinutes || !actualTimeMinutes || !packagingCost || !totalCostHint || !suggestedSalePriceHint || !targetMarginHint) {
                return;
            }

            var totalCostValue = totalCostHint.querySelector("strong");
            var suggestedSalePriceValue = suggestedSalePriceHint.querySelector("strong");
            var targetMarginValue = targetMarginHint.querySelector("span");

            function updateTotalProductionCostHint() {
                var productOption = productSelect.options[productSelect.selectedIndex];
                var materialOption = materialSelect.options[materialSelect.selectedIndex];
                var printerOption = printerSelect.options[printerSelect.selectedIndex];
                var targetMarginRaw = productOption ? productOption.getAttribute("data-target-margin-percentage") : "";
                var costPerGramRaw = materialOption ? materialOption.getAttribute("data-cost-per-gram") : "";
                var costPerHourRaw = printerOption ? printerOption.getAttribute("data-cost-per-hour") : "";
                var targetMarginPercentage = targetMarginRaw ? parseFloat(targetMarginRaw) : NaN;
                var costPerGram = costPerGramRaw ? parseFloat(costPerGramRaw) : NaN;
                var costPerHour = costPerHourRaw ? parseFloat(costPerHourRaw) : NaN;
                var grams = filamentUsedGrams.value ? parseFloat(filamentUsedGrams.value) : NaN;
                var actual = actualTimeMinutes.value ? parseFloat(actualTimeMinutes.value) : NaN;
                var estimated = estimatedTimeMinutes.value ? parseFloat(estimatedTimeMinutes.value) : NaN;
                var minutes = !isNaN(actual) ? actual : estimated;
                var packaging = packagingCost.value ? parseFloat(packagingCost.value) : NaN;

                targetMarginValue.textContent = isNaN(targetMarginPercentage)
                    ? "Não informada"
                    : targetMarginPercentage.toLocaleString("pt-BR", {
                        minimumFractionDigits: 1,
                        maximumFractionDigits: 1
                    }) + "%";

                if (isNaN(costPerGram) || isNaN(grams) || isNaN(costPerHour) || isNaN(minutes)) {
                    totalCostValue.textContent = "Não informado";
                    suggestedSalePriceValue.textContent = "Não informado";
                    return;
                }

                var materialCost = grams * costPerGram;
                var machineCost = (minutes / 60) * costPerHour;
                var packagingAmount = isNaN(packaging) ? 0 : packaging;
                var totalProductionCost = materialCost + machineCost + packagingAmount;

                totalCostValue.textContent = "R$ " + totalProductionCost.toLocaleString("pt-BR", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });

                suggestedSalePriceValue.textContent = isNaN(targetMarginPercentage)
                    ? "Não informado"
                    : "R$ " + (totalProductionCost * (1 + (targetMarginPercentage / 100))).toLocaleString("pt-BR", {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
            }

            productSelect.addEventListener("change", updateTotalProductionCostHint);
            materialSelect.addEventListener("change", updateTotalProductionCostHint);
            printerSelect.addEventListener("change", updateTotalProductionCostHint);
            filamentUsedGrams.addEventListener("input", updateTotalProductionCostHint);
            estimatedTimeMinutes.addEventListener("input", updateTotalProductionCostHint);
            actualTimeMinutes.addEventListener("input", updateTotalProductionCostHint);
            packagingCost.addEventListener("input", updateTotalProductionCostHint);
            updateTotalProductionCostHint();
        })();
    </script>
}
