@model IEnumerable<ThreeDManager.Domain.Entities.PrintJob>
@using ThreeDManager.Domain.Entities
@using ThreeDManager.Web.Presentation

@{
    ViewData["Title"] = "Produções";

    var products = ViewBag.Products as Dictionary<Guid, string> ?? new Dictionary<Guid, string>();
    var materials = ViewBag.Materials as Dictionary<Guid, string> ?? new Dictionary<Guid, string>();
    var printers = ViewBag.Printers as Dictionary<Guid, string> ?? new Dictionary<Guid, string>();
    var printerCostPerHour = ViewBag.PrinterCostPerHour as Dictionary<Guid, decimal?> ?? new Dictionary<Guid, decimal?>();
    var productSalePriceById = ViewBag.ProductSalePriceById as Dictionary<Guid, decimal?> ?? new Dictionary<Guid, decimal?>();
    var productTargetMarginPercentageById = ViewBag.ProductTargetMarginPercentageById as Dictionary<Guid, decimal?> ?? new Dictionary<Guid, decimal?>();
    var printerFilterName = ViewData["PrinterFilterName"] as string;
    var isPrinterFilterActive = ViewData["PrinterFilterId"] is not null;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Produções</h1>
        <p class="text-muted">Histórico de produções geradas a partir de arquivos importados.</p>
    </div>
</div>

@if (isPrinterFilterActive)
{
    <div class="alert alert-secondary d-flex justify-content-between align-items-center">
        <span>Filtrando por impressora: <strong>@(printerFilterName ?? "Impressora removida")</strong></span>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Ver todas</a>
    </div>
}

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        @(isPrinterFilterActive
            ? "Nenhuma produção registrada para esta impressora."
            : "Nenhuma produção registrada ainda.")
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Produto</th>
                <th>Material</th>
                <th>Impressora</th>
                <th>Arquivo</th>
                <th>Filamento</th>
                <th>Tempo estimado</th>
                <th>Unidades</th>
                <th>Custo calculado do material</th>
                <th>Custo de embalagem</th>
                <th>Custo de máquina estimado</th>
                <th>Custo total estimado da produção</th>
                <th>Margem estimada</th>
                <th>Preço de venda sugerido</th>
                <th>Diferença de custo</th>
                <th>Status da produção</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var job in Model)
            {
                var productName = job.ProductId.HasValue && products.TryGetValue(job.ProductId.Value, out var productValue)
                    ? productValue
                    : "Não vinculado";

                var materialName = job.MaterialId.HasValue && materials.TryGetValue(job.MaterialId.Value, out var materialValue)
                    ? materialValue
                    : "Não vinculado";

                var printerName = job.PrinterId.HasValue && printers.TryGetValue(job.PrinterId.Value, out var printerValue)
                    ? printerValue
                    : "Não vinculada";

                <tr>
                    <td>@productName</td>
                    <td>@materialName</td>
                    <td>@printerName</td>
                    <td>
                        @if (job.PrintImportId.HasValue)
                        {
                            <a asp-controller="PrintImports" asp-action="Details" asp-route-id="@job.PrintImportId">@job.SourceFileName</a>
                        }
                        else
                        {
                            @job.SourceFileName
                        }
                    </td>
                    <td>
                        @if (job.FilamentUsedGrams.HasValue)
                        {
                            <span>@job.FilamentUsedGrams.Value.ToString("N2") g</span>
                        }
                        else
                        {
                            <span class="text-muted">Não informado</span>
                        }
                    </td>
                    <td>
                        @if (job.EstimatedTimeMinutes.HasValue)
                        {
                            <span>@job.EstimatedTimeMinutes min</span>
                        }
                        else
                        {
                            <span class="text-muted">Não informado</span>
                        }
                    </td>
                    <td>@job.UnitsProduced</td>
                    <td>
                        @if (job.CalculatedMaterialCost.HasValue)
                        {
                            @job.CalculatedMaterialCost.Value.ToString("C")
                        }
                        else
                        {
                            <span class="text-muted">Não calc.</span>
                        }
                    </td>
                    <td>
                        @if (job.PackagingCost.HasValue)
                        {
                            @job.PackagingCost.Value.ToString("C")
                        }
                        else
                        {
                            <span class="text-muted">Não informado</span>
                        }
                    </td>
                    <td>
                        @{
                            decimal? jobCostPerHour = job.PrinterId.HasValue && printerCostPerHour.TryGetValue(job.PrinterId.Value, out var costPerHourValue)
                                ? costPerHourValue
                                : null;
                            var machineTimeMinutes = job.ActualTimeMinutes ?? job.EstimatedTimeMinutes;
                            decimal? estimatedMachineCost = (jobCostPerHour.HasValue && machineTimeMinutes.HasValue)
                                ? Math.Round((machineTimeMinutes.Value / 60m) * jobCostPerHour.Value, 2)
                                : (decimal?)null;
                        }
                        @if (estimatedMachineCost.HasValue)
                        {
                            <span>@estimatedMachineCost.Value.ToString("C")</span>
                            <small class="text-muted d-block">
                                @(job.ActualTimeMinutes.HasValue ? "tempo real" : "tempo estimado"): @machineTimeMinutes min
                            </small>
                        }
                        else
                        {
                            <span class="text-muted">Não disponível</span>
                        }
                    </td>
                    <td>
                        @{
                            decimal? estimatedTotalProductionCost = (job.CalculatedMaterialCost.HasValue && estimatedMachineCost.HasValue)
                                ? job.CalculatedMaterialCost.Value + estimatedMachineCost.Value + (job.PackagingCost ?? 0m)
                                : (decimal?)null;
                        }
                        @if (estimatedTotalProductionCost.HasValue)
                        {
                            var materialCost = job.CalculatedMaterialCost!.Value;
                            var machineCost = estimatedMachineCost!.Value;
                            <span>@estimatedTotalProductionCost.Value.ToString("C")</span>
                            <small class="text-muted d-block">
                                material @materialCost.ToString("C") + máquina @machineCost.ToString("C")@(job.PackagingCost.HasValue ? $" + embalagem {job.PackagingCost.Value.ToString("C")}" : string.Empty)
                            </small>
                        }
                        else
                        {
                            <span class="text-muted">Não disponível</span>
                        }
                    </td>
                    <td>
                        @{
                            decimal? productSalePrice = job.ProductId.HasValue && productSalePriceById.TryGetValue(job.ProductId.Value, out var salePriceValue)
                                ? salePriceValue
                                : null;
                            decimal? estimatedMargin = (productSalePrice.HasValue && estimatedTotalProductionCost.HasValue)
                                ? productSalePrice.Value - estimatedTotalProductionCost.Value
                                : (decimal?)null;
                            decimal? estimatedMarginPercentage = (estimatedMargin.HasValue && productSalePrice > 0m)
                                ? Math.Round((estimatedMargin.Value / productSalePrice.Value) * 100m, 1)
                                : (decimal?)null;
                        }
                        @if (estimatedMargin.HasValue)
                        {
                            var marginClass = estimatedMargin.Value > 0 ? "text-success" : estimatedMargin.Value < 0 ? "text-danger" : "text-muted";
                            var marginLabel = estimatedMargin.Value > 0 ? "lucro estimado" : estimatedMargin.Value < 0 ? "prejuízo estimado" : "sem margem";
                            <span class="@marginClass fw-semibold">
                                @estimatedMargin.Value.ToString("C")
                                @if (estimatedMarginPercentage.HasValue)
                                {
                                    <span>(@estimatedMarginPercentage.Value.ToString("N1")%)</span>
                                }
                            </span>
                            <small class="text-muted d-block">@marginLabel</small>
                        }
                        else if (!productSalePrice.HasValue)
                        {
                            <span class="text-muted">Sem preço de venda</span>
                        }
                        else
                        {
                            <span class="text-muted">Não disponível</span>
                        }
                    </td>
                    <td>
                        @{
                            decimal? productTargetMarginPercentage = job.ProductId.HasValue && productTargetMarginPercentageById.TryGetValue(job.ProductId.Value, out var targetMarginValue)
                                ? targetMarginValue
                                : null;
                            decimal? suggestedSalePrice = (estimatedTotalProductionCost.HasValue && productTargetMarginPercentage.HasValue)
                                ? Math.Round(estimatedTotalProductionCost.Value * (1 + (productTargetMarginPercentage.Value / 100m)), 2)
                                : (decimal?)null;
                        }
                        @if (suggestedSalePrice.HasValue)
                        {
                            <span class="fw-semibold">@suggestedSalePrice.Value.ToString("C")</span>
                            <small class="text-muted d-block">margem alvo @productTargetMarginPercentage!.Value.ToString("N1")%</small>
                        }
                        else if (!productTargetMarginPercentage.HasValue)
                        {
                            <span class="text-muted">Sem margem alvo</span>
                        }
                        else
                        {
                            <span class="text-muted">Não disponível</span>
                        }
                    </td>
                    <td>
                        @if (job.ReportedCost.HasValue && job.CalculatedMaterialCost.HasValue)
                        {
                            var costDifference = job.ReportedCost.Value - job.CalculatedMaterialCost.Value;
                            var differenceClass = costDifference > 0 ? "text-danger" : costDifference < 0 ? "text-warning" : "text-muted";
                            var differenceLabel = costDifference > 0 ? "acima do calculado" : costDifference < 0 ? "abaixo do calculado" : "sem diferença";
                            <span class="@differenceClass">
                                @costDifference.ToString("C") — @differenceLabel
                            </span>
                        }
                        else
                        {
                            <span class="text-muted">Não disponível</span>
                        }
                    </td>
                    <td>
                        <span class="badge @PrintJobStatusPresentation.GetBadgeClass(job.Status)">
                            @PrintJobStatusPresentation.GetDisplayLabel(job.Status)
                        </span>
                        @if (string.Equals(PrintJobStatus.Normalize(job.Status), PrintJobStatus.Failed, StringComparison.Ordinal))
                        {
                            <small class="text-muted d-block" title="@job.FailureReason">
                                Motivo: @(string.IsNullOrWhiteSpace(job.FailureReason) ? "Não informado" : job.FailureReason)
                            </small>
                        }
                    </td>
                    <td class="text-end">
                        <div class="d-flex justify-content-end gap-1">
                            <a asp-action="Details" asp-route-id="@job.Id" class="btn btn-sm btn-outline-secondary">Detalhes</a>
                            <a asp-action="Edit" asp-route-id="@job.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@job.Id" class="btn btn-sm btn-outline-danger">Remover</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
