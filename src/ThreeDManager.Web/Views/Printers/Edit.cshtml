@model ThreeDManager.Domain.Entities.Printer

@{
    ViewData["Title"] = "Editar impressora";
}

<h1>Editar impressora</h1>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CreatedAt" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Nome</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Brand" class="form-label">Marca</label>
        <input asp-for="Brand" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Model" class="form-label">Modelo</label>
        <input asp-for="Model" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Notes" class="form-label">Observações</label>
        <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Salvar alterações</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}