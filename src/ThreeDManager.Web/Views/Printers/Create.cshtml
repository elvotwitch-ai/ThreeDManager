@model ThreeDManager.Domain.Entities.Printer

@{
    ViewData["Title"] = "Nova impressora";
}

<h1>Nova impressora</h1>
<p class="text-muted">Cadastre uma impressora usada na produção 3D.</p>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Nome</label>
        <input asp-for="Name" class="form-control" placeholder="Ex: Ender 3 V3 SE principal" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Brand" class="form-label">Marca</label>
        <input asp-for="Brand" class="form-control" placeholder="Ex: Creality" />
    </div>

    <div class="mb-3">
        <label asp-for="Model" class="form-label">Modelo</label>
        <input asp-for="Model" class="form-control" placeholder="Ex: Ender-3 V3 SE" />
    </div>

    <div class="mb-3">
        <label asp-for="Notes" class="form-label">Observações</label>
        <textarea asp-for="Notes" class="form-control" rows="4" placeholder="Ex: Usa Creality Print 7.1, bico 0.4mm, filamento 1.75mm"></textarea>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Salvar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}