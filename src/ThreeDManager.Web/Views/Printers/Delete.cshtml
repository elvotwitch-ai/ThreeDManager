@model ThreeDManager.Domain.Entities.Printer

@{
    ViewData["Title"] = "Remover impressora";
}

<h1>Remover impressora</h1>

<div class="alert alert-warning">
    Tem certeza que deseja remover esta impressora? Impressoras com histórico de produção não poderão ser removidas.
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Nome</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Marca</dt>
            <dd class="col-sm-9">@Model.Brand</dd>

            <dt class="col-sm-3">Modelo</dt>
            <dd class="col-sm-9">@Model.Model</dd>

            <dt class="col-sm-3">Observações</dt>
            <dd class="col-sm-9">@Model.Notes</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">Confirmar remoção</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>