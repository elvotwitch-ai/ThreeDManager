@model ThreeDManager.Web.ViewModels.DashboardViewModel
@using ThreeDManager.Web.Presentation

@{
    ViewData["Title"] = "Dashboard";

    string FormatMinutes(int minutes)
    {
        var hours = minutes / 60;
        var remainingMinutes = minutes % 60;

        if (hours <= 0)
        {
            return $"{remainingMinutes} min";
        }

        return $"{hours}h {remainingMinutes}min";
    }
}

<div class="mb-4">
    <h1>Dashboard</h1>
    <p class="text-muted">
        Visão geral da produção 3D registrada no ThreeDManager.
    </p>
</div>

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] is not null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-primary h-100">
            <div class="card-body">
                <h6 class="text-muted">Produções totais</h6>
                <h2>@Model.TotalPrintJobs</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-success h-100">
            <div class="card-body">
                <h6 class="text-muted">Concluídas</h6>
                <h2>@Model.CompletedPrintJobs</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-danger h-100">
            <div class="card-body">
                <h6 class="text-muted">Falhas</h6>
                <h2>@Model.FailedPrintJobs</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-secondary h-100">
            <div class="card-body">
                <h6 class="text-muted">Planejadas/importadas</h6>
                <h2>@(Model.PlannedPrintJobs + Model.ImportedPrintJobs)</h2>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-primary h-100">
            <div class="card-body">
                <h6 class="text-muted">Importações totais</h6>
                <h2>@Model.TotalPrintImports</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-success h-100">
            <div class="card-body">
                <h6 class="text-muted">Importadas com sucesso</h6>
                <h2>@Model.ParsedPrintImports</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-danger h-100">
            <div class="card-body">
                <h6 class="text-muted">Importações com falha</h6>
                <h2>@Model.FailedPrintImports</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-warning h-100">
            <div class="card-body">
                <h6 class="text-muted">Pendentes de produção</h6>
                <h2>@Model.PendingProductionImports</h2>
                <a asp-controller="PrintImports" asp-action="Index" asp-route-productionState="pending" class="btn btn-sm btn-outline-warning">
                    Revisar importações
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="text-muted">Filamento usado</h6>
                <h3>@Model.TotalFilamentUsedGrams.ToString("N2") g</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="text-muted">Tempo estimado</h6>
                <h3>@FormatMinutes(Model.TotalEstimatedTimeMinutes)</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="text-muted">Tempo real</h6>
                <h3>@FormatMinutes(Model.TotalActualTimeMinutes)</h3>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card h-100">
            <div class="card-body">
                <h6 class="text-muted">Custo informado</h6>
                <h3>@Model.TotalReportedCost.ToString("C")</h3>
                <div class="text-muted small">
                    Material calculado: @Model.TotalCalculatedMaterialCost.ToString("C")
                </div>
                <div class="text-muted small">
                    Máquina estimada: @Model.TotalEstimatedMachineCost.ToString("C")
                </div>
                <div class="text-muted small">
                    Custo total estimado: @Model.TotalEstimatedProductionCost.ToString("C")
                </div>
                <div class="text-muted small">
                    Diferença de custo: @((Model.TotalReportedCost - Model.TotalCalculatedMaterialCost).ToString("C"))
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Alertas de estoque</strong>
        <a asp-controller="Materials" asp-action="Index" class="btn btn-sm btn-outline-primary">Ver materiais</a>
    </div>

    <div class="card-body">
        @if (!Model.LowStockMaterials.Any())
        {
            <div class="alert alert-success mb-0">
                Nenhum material em baixo estoque.
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                Existem <strong>@Model.LowStockMaterialsCount</strong> materiais em baixo estoque.
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Material</th>
                            <th>Estoque atual</th>
                            <th>Estoque mínimo</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var material in Model.LowStockMaterials)
                        {
                            <tr>
                                <td>@material.Name</td>
                                <td>@material.CurrentStockGrams.ToString("N2") g</td>
                                <td>@material.MinimumStockGrams.ToString("N2") g</td>
                                <td class="text-end">
                                    <a asp-controller="Materials" asp-action="Details" asp-route-id="@material.Id" class="btn btn-sm btn-outline-secondary">
                                        Detalhes
                                    </a>
                                    <a asp-controller="Materials" asp-action="AdjustStock" asp-route-id="@material.Id" class="btn btn-sm btn-outline-success">
                                        Ajustar estoque
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Movimentações de estoque recentes</strong>
        <a asp-controller="Materials" asp-action="Index" class="btn btn-sm btn-outline-primary">Ver materiais</a>
    </div>

    <div class="card-body">
        @if (!Model.RecentStockMovements.Any())
        {
            <div class="alert alert-info mb-0">
                Nenhuma movimentação de estoque registrada ainda.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Material</th>
                            <th>Movimento</th>
                            <th>Quantidade</th>
                            <th>Antes</th>
                            <th>Depois</th>
                            <th>Observação</th>
                            <th>Em</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var movement in Model.RecentStockMovements)
                        {
                            var movementLabel = movement.MovementType switch
                            {
                                "PrintJobCompleted" => "Baixa automática",
                                "PrintJobStockRestored" => "Devolução automática",
                                "ManualAdjustment" => "Ajuste manual",
                                _ => movement.MovementType
                            };

                            <tr>
                                <td>@movement.MaterialName</td>
                                <td>@movementLabel</td>
                                <td>
                                    <span class="@(movement.QuantityGrams < 0 ? "text-danger" : "text-success") fw-semibold">
                                        @movement.QuantityGrams.ToString("+0.##;-0.##;0.##") g
                                    </span>
                                </td>
                                <td>@(movement.StockBeforeGrams.HasValue ? $"{movement.StockBeforeGrams.Value:N2} g" : "-")</td>
                                <td>@(movement.StockAfterGrams.HasValue ? $"{movement.StockAfterGrams.Value:N2} g" : "-")</td>
                                <td>@(string.IsNullOrWhiteSpace(movement.Notes) ? "-" : movement.Notes)</td>
                                <td>@movement.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Importações com falha recentes</strong>
        <a asp-controller="PrintImports" asp-action="Index" asp-route-status="error" class="btn btn-sm btn-outline-danger">Revisar falhas</a>
    </div>

    <div class="card-body">
        @if (!Model.RecentFailedImports.Any())
        {
            <div class="alert alert-success mb-0">
                Nenhuma importação com falha registrada.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Arquivo</th>
                            <th>Status</th>
                            <th>Recuperação</th>
                            <th>Erro</th>
                            <th>Importado em</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var import in Model.RecentFailedImports)
                        {
                            <tr>
                                <td>@import.FileName</td>
                                <td><span class="badge bg-danger">Falha</span></td>
                                <td>
                                    @if (import.CanProcessAgain)
                                    {
                                        <span class="badge bg-warning text-dark">Pode tentar novamente</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Reimportar arquivo</span>
                                    }
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(import.ErrorMessage) ? "Erro não informado" : import.ErrorMessage)</td>
                                <td>@import.ImportedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end">
                                    <a asp-controller="PrintImports" asp-action="Details" asp-route-id="@import.Id" class="btn btn-sm btn-outline-secondary">
                                        Detalhes
                                    </a>
                                    @if (import.CanProcessAgain)
                                    {
                                        <form asp-controller="PrintImports" asp-action="Process" asp-route-id="@import.Id" method="post" class="m-0 d-inline-block">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="returnTo" value="dashboard" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                                Tentar novamente
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong>Últimas produções</strong>
        <a asp-controller="PrintJobs" asp-action="Index" class="btn btn-sm btn-outline-primary">Ver todas</a>
    </div>

    <div class="card-body">
        @if (!Model.RecentPrintJobs.Any())
        {
            <div class="alert alert-info mb-0">
                Nenhuma produção registrada ainda.
            </div>
        }
        else
        {
            <table class="table table-striped table-hover mb-0">
                <thead>
                    <tr>
                        <th>Produto</th>
                        <th>Material</th>
                        <th>Impressora</th>
                        <th>Arquivo</th>
                        <th>Filamento usado</th>
                        <th>Tempo estimado</th>
                        <th>Custos da produção</th>
                        <th>Status da produção</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var job in Model.RecentPrintJobs)
                    {
                        <tr>
                            <td>@job.ProductName</td>
                            <td>@job.MaterialName</td>
                            <td>@job.PrinterName</td>
                            <td>@job.SourceFileName</td>
                            <td>
                                @if (job.FilamentUsedGrams.HasValue)
                                {
                                    <span>@job.FilamentUsedGrams.Value.ToString("N2") g</span>
                                }
                                else
                                {
                                    <span class="text-muted">Não informado</span>
                                }
                            </td>
                            <td>
                                @if (job.EstimatedTimeMinutes.HasValue)
                                {
                                    <span>@FormatMinutes(job.EstimatedTimeMinutes.Value)</span>
                                }
                                else
                                {
                                    <span class="text-muted">Não informado</span>
                                }
                            </td>
                            <td>
                                @if (job.ReportedCost.HasValue)
                                {
                                    <div>Custo informado: @job.ReportedCost.Value.ToString("C")</div>
                                }
                                else
                                {
                                    <div class="text-muted">Custo informado: não disponível</div>
                                }

                                @if (job.CalculatedMaterialCost.HasValue)
                                {
                                    <div class="text-muted small">Custo calculado do material: @job.CalculatedMaterialCost.Value.ToString("C")</div>
                                }
                                else
                                {
                                    <div class="text-muted small">Custo calculado do material: não disponível</div>
                                }
                            </td>
                            <td>
                                <span class="badge @PrintJobStatusPresentation.GetBadgeClass(job.Status)">
                                    @PrintJobStatusPresentation.GetDisplayLabel(job.Status)
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-controller="PrintJobs" asp-action="Details" asp-route-id="@job.Id" class="btn btn-sm btn-outline-secondary">
                                    Detalhes
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
