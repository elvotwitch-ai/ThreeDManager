@model ThreeDManager.Domain.Entities.Material

@{
    ViewData["Title"] = "Novo material";
}

<div class="mb-4">
    <h1 class="mb-1">Novo material</h1>
    <p class="text-muted mb-0">Cadastre o material usado nas impressões 3D.</p>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Nome</label>
                <input asp-for="Name" class="form-control" placeholder="Ex: PLA Preto" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Type" class="form-label">Tipo</label>
                <input asp-for="Type" class="form-control" placeholder="Ex: PLA, PETG, TPU, ABS, Resina" />
            </div>

            <div class="mb-3">
                <label asp-for="Brand" class="form-label">Marca</label>
                <input asp-for="Brand" class="form-control" placeholder="Ex: Creality, Sunlu, Anycubic" />
            </div>

            <div class="mb-3">
                <label asp-for="Color" class="form-label">Cor</label>
                <input asp-for="Color" class="form-control" placeholder="Ex: Preto, Branco, Transparente" />
            </div>

            <div class="mb-3">
                <label asp-for="CostPerKg" class="form-label">Custo por kg</label>
                <input asp-for="CostPerKg" class="form-control" type="number" step="0.01" min="0" />
            </div>

            <div class="mb-3">
                <label asp-for="CurrentStockGrams" class="form-label">Estoque atual em gramas</label>
                <input asp-for="CurrentStockGrams" class="form-control" type="number" step="0.01" min="0" />
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Salvar</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
