@model ThreeDManager.Domain.Entities.Material

@{
    ViewData["Title"] = "Detalhes do material";
}

<div class="mb-4">
    <h1 class="mb-1">@Model.Name</h1>
    <p class="text-muted mb-0">Detalhes do material cadastrado.</p>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            <dt class="col-sm-3">Nome</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Tipo</dt>
            <dd class="col-sm-9">@(Model.Type ?? "-")</dd>

            <dt class="col-sm-3">Marca</dt>
            <dd class="col-sm-9">@(Model.Brand ?? "-")</dd>

            <dt class="col-sm-3">Cor</dt>
            <dd class="col-sm-9">@(Model.Color ?? "-")</dd>

            <dt class="col-sm-3">Custo por kg</dt>
            <dd class="col-sm-9">
                @if (Model.CostPerKg.HasValue)
                {
                    <span>@Model.CostPerKg.Value.ToString("C")</span>
                }
                else
                {
                    <span class="text-muted">Não informado</span>
                }
            </dd>

            <dt class="col-sm-3">Estoque atual</dt>
            <dd class="col-sm-9">
                @if (Model.CurrentStockGrams.HasValue)
                {
                    <span>@Model.CurrentStockGrams.Value.ToString("N2") g</span>
                }
                else
                {
                    <span class="text-muted">Não informado</span>
                }
            </dd>

            <dt class="col-sm-3">Criado em</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
        </dl>
    </div>
</div>

<div class="mt-3 d-flex gap-2">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Remover</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</div>
