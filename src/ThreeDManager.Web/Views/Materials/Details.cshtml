@model ThreeDManager.Domain.Entities.Material
@using ThreeDManager.Domain.Entities

@{
    ViewData["Title"] = "Detalhes do material";
    var stockMovements = ViewBag.StockMovements as List<MaterialStockMovement> ?? new List<MaterialStockMovement>();
}

<div class="mb-4">
    <h1 class="mb-1">@Model.Name</h1>
    <p class="text-muted mb-0">Detalhes do material cadastrado.</p>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            <dt class="col-sm-3">Nome</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Tipo</dt>
            <dd class="col-sm-9">@(Model.Type ?? "-")</dd>

            <dt class="col-sm-3">Marca</dt>
            <dd class="col-sm-9">@(Model.Brand ?? "-")</dd>

            <dt class="col-sm-3">Cor</dt>
            <dd class="col-sm-9">@(Model.Color ?? "-")</dd>

            <dt class="col-sm-3">Custo por kg</dt>
            <dd class="col-sm-9">
                @if (Model.CostPerKg.HasValue)
                {
                    <span>@Model.CostPerKg.Value.ToString("C")</span>
                }
                else
                {
                    <span class="text-muted">Não informado</span>
                }
            </dd>

            <dt class="col-sm-3">Custo por grama</dt>
            <dd class="col-sm-9">
                @if (Model.CostPerKg.HasValue)
                {
                    <span>@((Model.CostPerKg.Value / 1000m).ToString("C4"))</span>
                }
                else
                {
                    <span class="text-muted">Não informado</span>
                }
            </dd>

            <dt class="col-sm-3">Estoque atual</dt>
            <dd class="col-sm-9">
                @if (Model.CurrentStockGrams.HasValue)
                {
                    <span>@Model.CurrentStockGrams.Value.ToString("N2") g</span>
                }
                else
                {
                    <span class="text-muted">Não informado</span>
                }
            </dd>

            <dt class="col-sm-3">Estoque mínimo</dt>
            <dd class="col-sm-9">
                @if (Model.MinimumStockGrams.HasValue)
                {
                    <span>@Model.MinimumStockGrams.Value.ToString("N2") g</span>
                }
                else
                {
                    <span class="text-muted">Não definido</span>
                }
            </dd>

            <dt class="col-sm-3">Status do estoque</dt>
            <dd class="col-sm-9">
                @{
                    var hasCurrentStock = Model.CurrentStockGrams.HasValue;
                    var hasMinimumStock = Model.MinimumStockGrams.HasValue;
                    var currentStockGrams = Model.CurrentStockGrams.GetValueOrDefault();
                    var minimumStockGrams = Model.MinimumStockGrams.GetValueOrDefault();
                    var isLowStock = hasCurrentStock
                        && hasMinimumStock
                        && currentStockGrams <= minimumStockGrams;
                }

                @if (isLowStock)
                {
                    <span class="badge bg-danger">Baixo estoque</span>
                }
                else if (hasCurrentStock && hasMinimumStock)
                {
                    <span class="badge bg-success">Ok</span>
                }
                else
                {
                    <span class="badge bg-secondary">Sem alerta configurado</span>
                }
            </dd>

            <dt class="col-sm-3">Criado em</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
        </dl>
    </div>
</div>

<div class="mt-4">
    <h2 class="h4 mb-3">Movimentações de estoque</h2>

    @if (!stockMovements.Any())
    {
        <div class="alert alert-info">Nenhuma movimentação de estoque registrada para este material.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Tipo</th>
                        <th>Quantidade</th>
                        <th>Antes</th>
                        <th>Depois</th>
                        <th>Observações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var movement in stockMovements)
                    {
                        var movementLabel = movement.MovementType switch
                        {
                            "PrintJobCompleted" => "Baixa automática",
                            "PrintJobStockRestored" => "Devolução automática",
                            "ManualAdjustment" => "Ajuste manual",
                            _ => movement.MovementType
                        };

                        <tr>
                            <td>@movement.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@movementLabel</td>
                            <td class="@(movement.QuantityGrams < 0 ? "text-danger" : "text-success")">
                                @if (movement.QuantityGrams > 0)
                                {
                                    <text>+</text>
                                }
                                @movement.QuantityGrams.ToString("N2")<text> g</text>
                            </td>
                            <td>
                                @if (movement.StockBeforeGrams.HasValue)
                                {
                                    @movement.StockBeforeGrams.Value.ToString("N2")<text> g</text>
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </td>
                            <td>
                                @if (movement.StockAfterGrams.HasValue)
                                {
                                    @movement.StockAfterGrams.Value.ToString("N2")<text> g</text>
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </td>
                            <td>@(movement.Notes ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="mt-3 d-flex flex-wrap gap-2">
    <a asp-action="AdjustStock" asp-route-id="@Model.Id" class="btn btn-success">Ajustar estoque</a>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Remover</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</div>
