@model IEnumerable<ThreeDManager.Domain.Entities.Material>
@using ThreeDManager.Domain.Entities

@{
    ViewData["Title"] = "Materiais";
    var latestStockMovements = ViewBag.LatestStockMovements as Dictionary<Guid, MaterialStockMovement> ?? new Dictionary<Guid, MaterialStockMovement>();
    var stockStatusFilter = ViewData["StockStatusFilter"] as string;
    var lowStockMaterialCount = ViewData["LowStockMaterialCount"] as int? ?? 0;
    var isLowStockFilter = stockStatusFilter == "low";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">Materiais</h1>
        <p class="text-muted mb-0">Cadastro de filamentos, resinas e outros materiais usados na produção.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">Novo material</a>
</div>

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <a asp-action="Index"
       class="btn btn-sm @(isLowStockFilter ? "btn-outline-secondary" : "btn-secondary")">
        Todos
    </a>
    <a asp-action="Index"
       asp-route-stockStatus="low"
       class="btn btn-sm @(isLowStockFilter ? "btn-danger" : "btn-outline-danger")">
        Baixo estoque (@lowStockMaterialCount)
    </a>
</div>

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success" role="alert">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] is not null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        @(isLowStockFilter
            ? "Nenhum material em baixo estoque no momento."
            : "Nenhum material cadastrado ainda. Clique em \"Novo material\" para começar.")
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Tipo</th>
                <th>Marca</th>
                <th>Cor</th>
                <th>Custo por kg (R$)</th>
                <th>Custo por grama</th>
                <th>Estoque atual</th>
                <th>Estoque mínimo</th>
                <th>Status estoque</th>
                <th>Movimentação recente</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            @{
                var rowReturnTo = isLowStockFilter ? "lowStock" : null;
            }
            @foreach (var material in Model)
            {
                latestStockMovements.TryGetValue(material.Id, out var latestMovement);
                var movementLabel = latestMovement?.MovementType switch
                {
                    "PrintJobCompleted" => "Baixa automática",
                    "PrintJobStockRestored" => "Devolução automática",
                    "ManualAdjustment" => "Ajuste manual",
                    _ => latestMovement?.MovementType
                };

                <tr>
                    <td class="fw-semibold">@material.Name</td>
                    <td>@(material.Type ?? "-")</td>
                    <td>@(material.Brand ?? "-")</td>
                    <td>@(material.Color ?? "-")</td>
                    <td>
                        @if (material.CostPerKg.HasValue)
                        {
                            <span>@material.CostPerKg.Value.ToString("C")</span>
                        }
                        else
                        {
                            <span class="badge text-bg-light">Não informado</span>
                        }
                    </td>
                    <td>
                        @if (material.CostPerKg.HasValue)
                        {
                            <span>@((material.CostPerKg.Value / 1000m).ToString("C4"))</span>
                        }
                        else
                        {
                            <span class="badge text-bg-light">Não informado</span>
                        }
                    </td>
                    <td>
                        @if (material.CurrentStockGrams.HasValue)
                        {
                            <span>@material.CurrentStockGrams.Value.ToString("N2") g</span>
                        }
                        else
                        {
                            <span class="badge text-bg-light">Não informado</span>
                        }
                    </td>
                    <td>
                        @if (material.MinimumStockGrams.HasValue)
                        {
                            <span>@material.MinimumStockGrams.Value.ToString("N2") g</span>
                        }
                        else
                        {
                            <span class="text-muted">Não definido</span>
                        }
                    </td>
                    <td>
                        @{
                            var hasCurrentStock = material.CurrentStockGrams.HasValue;
                            var hasMinimumStock = material.MinimumStockGrams.HasValue;
                            var currentStockGrams = material.CurrentStockGrams.GetValueOrDefault();
                            var minimumStockGrams = material.MinimumStockGrams.GetValueOrDefault();
                            var isLowStock = hasCurrentStock
                                && hasMinimumStock
                                && currentStockGrams <= minimumStockGrams;
                        }

                        @if (isLowStock)
                        {
                            <span class="badge bg-danger">Baixo estoque</span>
                        }
                        else if (hasCurrentStock && hasMinimumStock)
                        {
                            <span class="badge bg-success">Ok</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Sem alerta</span>
                        }
                    </td>
                    <td>
                        @if (latestMovement is null)
                        {
                            <span class="badge text-bg-light">Sem histórico</span>
                        }
                        else
                        {
                            <div class="small fw-semibold @(latestMovement.QuantityGrams < 0 ? "text-danger" : "text-success")">
                                @(latestMovement.QuantityGrams > 0 ? "+" : string.Empty)@latestMovement.QuantityGrams.ToString("N2") g
                            </div>
                            <div class="small text-muted">
                                @movementLabel
                                @if (latestMovement.CreatedAt != default)
                                {
                                    <span>• @latestMovement.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(latestMovement.Notes))
                            {
                                <div class="small text-muted">@latestMovement.Notes</div>
                            }
                        }
                    </td>
                    <td class="text-end">
                        <div class="btn-group btn-group-sm flex-wrap" role="group" aria-label="Ações do material">
                            <a asp-action="Details" asp-route-id="@material.Id" asp-route-returnTo="@rowReturnTo" class="btn btn-outline-secondary">Detalhes</a>
                            <a asp-action="Edit" asp-route-id="@material.Id" asp-route-returnTo="@rowReturnTo" class="btn btn-outline-primary">Editar</a>
                            <a asp-action="AdjustStock" asp-route-id="@material.Id" asp-route-returnTo="@rowReturnTo" class="btn btn-outline-success">Estoque</a>
                            <a asp-action="Delete" asp-route-id="@material.Id" asp-route-returnTo="@rowReturnTo" class="btn btn-outline-danger">Remover</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
        </table>
    </div>
}
