@model ThreeDManager.Domain.Entities.Material

@{
    ViewData["Title"] = "Remover material";
}

<div class="mb-4">
    <h1 class="mb-1">Remover material</h1>
    <p class="text-muted mb-0">Confirme a exclusão somente se tiver certeza.</p>
</div>

<div class="alert alert-warning" role="alert">
    Tem certeza que deseja remover este material? Materiais com histórico de produção não poderão ser removidos.
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Nome</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Tipo</dt>
            <dd class="col-sm-9">@(Model.Type ?? "-")</dd>

            <dt class="col-sm-3">Marca</dt>
            <dd class="col-sm-9">@(Model.Brand ?? "-")</dd>

            <dt class="col-sm-3">Cor</dt>
            <dd class="col-sm-9">@(Model.Color ?? "-")</dd>

            <dt class="col-sm-3">Custo por kg (R$)</dt>
            <dd class="col-sm-9">
                @if (Model.CostPerKg.HasValue)
                {
                    <span>@Model.CostPerKg.Value.ToString("C")</span>
                }
                else
                {
                    <span class="text-muted">Não informado</span>
                }
            </dd>

            <dt class="col-sm-3">Estoque atual</dt>
            <dd class="col-sm-9">
                @if (Model.CurrentStockGrams.HasValue)
                {
                    <span>@Model.CurrentStockGrams.Value.ToString("N2") g</span>
                }
                else
                {
                    <span class="text-muted">Não informado</span>
                }
            </dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">Confirmar remoção</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
