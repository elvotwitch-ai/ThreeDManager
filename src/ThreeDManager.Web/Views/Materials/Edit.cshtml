@model ThreeDManager.Domain.Entities.Material

@{
    ViewData["Title"] = "Editar material";
}

<div class="mb-4">
    <h1 class="mb-1">Editar material</h1>
    <p class="text-muted mb-0">Atualize as informações cadastradas.</p>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Nome</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Type" class="form-label">Tipo</label>
                <input asp-for="Type" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Brand" class="form-label">Marca</label>
                <input asp-for="Brand" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Color" class="form-label">Cor</label>
                <input asp-for="Color" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="CostPerKg" class="form-label">Custo por kg (R$)</label>
                <input asp-for="CostPerKg" class="form-control" type="number" step="0.01" placeholder="Ex: 85,00 para 1kg" />
                <div class="form-text">
                    Informe o valor pago por 1kg de material. Exemplo: rolo de PLA 1kg por R$ 85,00.
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="CurrentStockGrams" class="form-label">Estoque atual em gramas</label>
                <input asp-for="CurrentStockGrams" class="form-control" type="number" step="0.01" min="0" />
            </div>

            <div class="mb-3">
                <label asp-for="MinimumStockGrams" class="form-label">Estoque mínimo em gramas</label>
                <input asp-for="MinimumStockGrams" class="form-control" type="number" step="0.01" />
                <div class="form-text">
                    Quando o estoque atual ficar igual ou abaixo deste valor, o material será marcado como baixo estoque.
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Salvar alterações</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
