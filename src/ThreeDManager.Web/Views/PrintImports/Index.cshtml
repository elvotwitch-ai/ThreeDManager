@using ThreeDManager.Domain.Entities
@model IEnumerable<ThreeDManager.Domain.Entities.PrintImport>

@{
    ViewData["Title"] = "Importações";
    var linkedPrintJobIdsByImportId = ViewData["LinkedPrintJobIdsByImportId"] as IReadOnlyDictionary<Guid, Guid> ?? new Dictionary<Guid, Guid>();
    var processAvailabilityByImportId = ViewData["ProcessAvailabilityByImportId"] as IReadOnlyDictionary<Guid, (bool CanProcess, string? Message)>
        ?? new Dictionary<Guid, (bool CanProcess, string? Message)>();
    var productionStateFilter = ViewData["ProductionStateFilter"] as string;
    var statusFilter = ViewData["StatusFilter"] as string;
    var pendingProductionImportCount = ViewData["PendingProductionImportCount"] as int? ?? 0;
    var failedImportCount = ViewData["FailedImportCount"] as int? ?? 0;
    var isPendingProductionFilter = productionStateFilter == "pending";
    var isErrorStatusFilter = statusFilter == "error";
    var isAnyFilterActive = isPendingProductionFilter || isErrorStatusFilter;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Importações</h1>
        <p class="text-muted">Arquivos brutos importados para análise e processamento.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">Importar arquivo</a>
</div>

<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <a asp-action="Index"
       class="btn btn-sm @(isAnyFilterActive ? "btn-outline-secondary" : "btn-secondary")">
        Todas
    </a>
    <a asp-action="Index"
       asp-route-productionState="pending"
       class="btn btn-sm @(isPendingProductionFilter ? "btn-warning" : "btn-outline-warning")">
        Pendentes de produção (@pendingProductionImportCount)
    </a>
    <a asp-action="Index"
       asp-route-status="error"
       class="btn btn-sm @(isErrorStatusFilter ? "btn-danger" : "btn-outline-danger")">
        Falhas (@failedImportCount)
    </a>
</div>

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] is not null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        @(isPendingProductionFilter
            ? "Nenhuma importação pendente de geração de produção."
            : isErrorStatusFilter
                ? "Nenhuma importação com falha no momento."
                : "Nenhum arquivo importado ainda.")
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Arquivo</th>
                <th>Tipo</th>
                <th>Status</th>
                <th>Produção</th>
                <th>Importado em</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var import in Model)
            {
                var normalizedStatus = PrintImportStatus.Normalize(import.Status);
                var hasLinkedProduction = linkedPrintJobIdsByImportId.TryGetValue(import.Id, out var linkedPrintJobId);
                var processAvailability = processAvailabilityByImportId.TryGetValue(import.Id, out var currentProcessAvailability)
                    ? currentProcessAvailability
                    : (false, null);
                var canGenerateProduction = normalizedStatus == PrintImportStatus.Parsed
                    && !string.IsNullOrWhiteSpace(import.ParsedDataJson)
                    && !hasLinkedProduction;

                <tr>
                    <td>@import.FileName</td>
                    <td>@import.FileType</td>
                    <td>
                        @if (normalizedStatus == PrintImportStatus.Uploaded)
                        {
                            <span class="badge bg-primary">Importado</span>
                        }
                        else if (normalizedStatus == PrintImportStatus.Parsed)
                        {
                            <span class="badge bg-success">Processado</span>
                        }
                        else if (normalizedStatus == PrintImportStatus.Error)
                        {
                            <span class="badge bg-danger">Erro</span>
                            if (!string.IsNullOrWhiteSpace(processAvailability.Message))
                            {
                                <div class="small text-muted mt-1">
                                    @(processAvailability.CanProcess
                                        ? "Pode tentar processar novamente."
                                        : "Reimporte um arquivo compatível para seguir.")
                                </div>
                            }
                        }
                        else
                        {
                            <span class="badge bg-secondary">@import.Status</span>
                        }
                    </td>
                    <td>
                        @if (hasLinkedProduction)
                        {
                            <span class="badge bg-success">Vinculada</span>
                        }
                        else if (canGenerateProduction)
                        {
                            <span class="badge bg-warning text-dark">Pendente</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Indisponível</span>
                        }
                    </td>
                    <td>@import.ImportedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-end">
                        <div class="d-flex justify-content-end gap-1">
                            @if (hasLinkedProduction)
                            {
                                <a asp-controller="PrintJobs" asp-action="Details" asp-route-id="@linkedPrintJobId" class="btn btn-sm btn-outline-success">Ver produção</a>
                            }
                            else if (canGenerateProduction)
                            {
                                <a asp-action="CreatePrintJob" asp-route-id="@import.Id" class="btn btn-sm btn-outline-success">Gerar produção</a>
                            }

                            <a asp-action="Details" asp-route-id="@import.Id" class="btn btn-sm btn-outline-secondary">Detalhes</a>

                            @if (processAvailability.CanProcess)
                            {
                                <form asp-action="Process" asp-route-id="@import.Id" method="post" class="m-0 d-inline-block">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-primary">
                                        @(normalizedStatus == PrintImportStatus.Error ? "Tentar novamente" : "Processar")
                                    </button>
                                </form>
                            }

                            <a asp-action="Delete" asp-route-id="@import.Id" class="btn btn-sm btn-outline-danger">Remover</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
