@using ThreeDManager.Domain.Entities
@model IEnumerable<ThreeDManager.Domain.Entities.PrintImport>

@{
    ViewData["Title"] = "Importações";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Importações</h1>
        <p class="text-muted">Arquivos brutos importados para análise e processamento.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">Importar arquivo</a>
</div>

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] is not null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        Nenhum arquivo importado ainda.
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Arquivo</th>
                <th>Tipo</th>
                <th>Status</th>
                <th>Importado em</th>
                <th class="text-end">Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var import in Model)
            {
                var normalizedStatus = PrintImportStatus.Normalize(import.Status);

                <tr>
                    <td>@import.FileName</td>
                    <td>@import.FileType</td>
                    <td>
                        @if (normalizedStatus == PrintImportStatus.Uploaded)
                        {
                            <span class="badge bg-primary">Importado</span>
                        }
                        else if (normalizedStatus == PrintImportStatus.Parsed)
                        {
                            <span class="badge bg-success">Processado</span>
                        }
                        else if (normalizedStatus == PrintImportStatus.Error)
                        {
                            <span class="badge bg-danger">Erro</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@import.Status</span>
                        }
                    </td>
                    <td>@import.ImportedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-end">
                        <div class="d-flex justify-content-end gap-1">
                            <a asp-action="Details" asp-route-id="@import.Id" class="btn btn-sm btn-outline-secondary">Detalhes</a>

                            <form asp-action="Process" asp-route-id="@import.Id" method="post" class="m-0 d-inline-block">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-primary">Processar</button>
                            </form>

                            <a asp-action="Delete" asp-route-id="@import.Id" class="btn btn-sm btn-outline-danger">Remover</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
