@model ThreeDManager.Web.ViewModels.PrintJobFromImportViewModel

@{
    ViewData["Title"] = "Gerar produção";
    var returnTo = Model.ReturnTo;
}

<h1>Gerar produção</h1>

<p class="text-muted">
    Confirme os dados extraídos do arquivo e vincule a produção a um produto, material e impressora.
</p>

<div class="alert alert-info">
    Arquivo origem: <strong>@Model.FileName</strong>
</div>

<form asp-action="CreatePrintJob" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <input type="hidden" asp-for="ImportId" />
    <input type="hidden" asp-for="FileName" />
    <input type="hidden" asp-for="ReturnTo" />
    <input type="hidden" asp-for="ParsedMaterialType" />

    <div class="mb-3">
        <label asp-for="ProductId" class="form-label">Produto</label>
        <select asp-for="ProductId" asp-items="Model.ProductOptions" class="form-select">
            <option value="">Selecione um produto</option>
        </select>
        <span asp-validation-for="ProductId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PrinterId" class="form-label">Impressora</label>
        <select asp-for="PrinterId" asp-items="Model.PrinterOptions" class="form-select">
            <option value="">Selecione uma impressora</option>
        </select>
        <span asp-validation-for="PrinterId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="MaterialId" class="form-label">Material</label>
        <select asp-for="MaterialId" class="form-select" id="materialSelect">
            <option value="">Selecione um material</option>
            @foreach (var option in Model.MaterialOptions)
            {
                var costPerGram = Model.MaterialCostPerGramById.TryGetValue(option.Value, out var cost) ? cost : null;
                var costAttribute = costPerGram.HasValue
                    ? costPerGram.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)
                    : string.Empty;
                <option value="@option.Value" data-cost-per-gram="@costAttribute">@option.Text</option>
            }
        </select>
        <span asp-validation-for="MaterialId" class="text-danger"></span>

        <div class="form-text" id="materialCostPerGramHint">Custo por grama do material: <span>Não informado</span></div>

        @if (!string.IsNullOrWhiteSpace(Model.ParsedMaterialType))
        {
            <div class="form-text">
                Material detectado no arquivo: <strong>@Model.ParsedMaterialType</strong>
            </div>
        }
    </div>

    <hr />

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="FilamentUsedGrams" class="form-label">Filamento usado (g)</label>
            <input asp-for="FilamentUsedGrams" class="form-control" type="number" step="0.01" id="filamentUsedGrams" />
            <div class="form-text" id="estimatedMaterialCostHint">Custo estimado do material: <span>Não informado</span></div>
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="FilamentUsedMeters" class="form-label">Filamento usado (m)</label>
            <input asp-for="FilamentUsedMeters" class="form-control" type="number" step="0.01" />
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="EstimatedTimeMinutes" class="form-label">Tempo estimado (min)</label>
            <input asp-for="EstimatedTimeMinutes" class="form-control" type="number" />
        </div>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="ActualTimeMinutes" class="form-label">Tempo real (min)</label>
            <input asp-for="ActualTimeMinutes" class="form-control" type="number" />
            <div class="form-text">
                Pode ficar vazio por enquanto.
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="ReportedCost" class="form-label">Custo informado pelo arquivo (R$)</label>
            <input asp-for="ReportedCost" class="form-control" type="number" step="0.01" />
        </div>

        <div class="col-md-4 mb-3">
            <label asp-for="Status" class="form-label">Status da produção</label>
            <select asp-for="Status" asp-items="Model.StatusOptions" class="form-select"></select>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Gerar produção</button>
        <a asp-action="Details"
           asp-route-id="@Model.ImportId"
           asp-route-returnTo="@returnTo"
           class="btn btn-outline-secondary">Cancelar</a>
        @if (returnTo == "pendingQueue")
        {
            <a asp-action="Index" asp-route-productionState="pending" class="btn btn-outline-secondary">Voltar para pendentes</a>
        }
        else if (returnTo == "errorQueue")
        {
            <a asp-action="Index" asp-route-status="error" class="btn btn-outline-secondary">Voltar para falhas</a>
        }
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        (function () {
            var materialSelect = document.getElementById("materialSelect");
            var filamentUsedGrams = document.getElementById("filamentUsedGrams");
            var costPerGramHint = document.getElementById("materialCostPerGramHint");
            var estimatedCostHint = document.getElementById("estimatedMaterialCostHint");

            if (!materialSelect || !filamentUsedGrams || !costPerGramHint || !estimatedCostHint) {
                return;
            }

            var costPerGramValue = costPerGramHint.querySelector("span");
            var estimatedCostValue = estimatedCostHint.querySelector("span");

            function updateCostHints() {
                var selectedOption = materialSelect.options[materialSelect.selectedIndex];
                var raw = selectedOption ? selectedOption.getAttribute("data-cost-per-gram") : "";
                var costPerGram = raw ? parseFloat(raw) : NaN;
                var grams = filamentUsedGrams.value ? parseFloat(filamentUsedGrams.value) : NaN;

                if (isNaN(costPerGram)) {
                    costPerGramValue.textContent = "Não informado";
                    estimatedCostValue.textContent = "Não informado";
                    return;
                }

                costPerGramValue.textContent = "R$ " + costPerGram.toLocaleString("pt-BR", {
                    minimumFractionDigits: 4,
                    maximumFractionDigits: 4
                });

                estimatedCostValue.textContent = isNaN(grams)
                    ? "Não informado"
                    : "R$ " + (grams * costPerGram).toLocaleString("pt-BR", {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
            }

            materialSelect.addEventListener("change", updateCostHints);
            filamentUsedGrams.addEventListener("input", updateCostHints);
            updateCostHints();
        })();
    </script>
}
