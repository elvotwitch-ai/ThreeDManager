@model ThreeDManager.Domain.Entities.PrintImport

@{
    ViewData["Title"] = "Remover importação";
}

<h1>Remover importação</h1>

<div class="alert alert-warning">
    Tem certeza que deseja remover esta importação? Importações com produções vinculadas não poderão ser removidas.
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Arquivo</dt>
            <dd class="col-sm-9">@Model.FileName</dd>

            <dt class="col-sm-3">Tipo</dt>
            <dd class="col-sm-9">@Model.FileType</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>

            <dt class="col-sm-3">Importado em</dt>
            <dd class="col-sm-9">@Model.ImportedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">Confirmar remoção</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>