@using ThreeDManager.Domain.Entities
@model ThreeDManager.Domain.Entities.PrintImport

@{
    ViewData["Title"] = "Detalhes da importação";

    var rawLines = (Model.RawContent ?? string.Empty)
        .Split('\n')
        .Take(120)
        .ToList();

    var totalLines = (Model.RawContent ?? string.Empty)
        .Split('\n')
        .Length;

    var normalizedStatus = PrintImportStatus.Normalize(Model.Status);
    var linkedPrintJobId = ViewData["LinkedPrintJobId"] is Guid value ? value : (Guid?)null;
    var canProcessImport = ViewData["CanProcessImport"] is true;
    var processImportHint = ViewData["ProcessImportHint"] as string;
    var returnTo = ViewData["ReturnTo"] as string;
}

<h1>@Model.FileName</h1>

<p class="text-muted">Detalhes do arquivo importado.</p>

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] is not null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            <dt class="col-sm-3">Arquivo</dt>
            <dd class="col-sm-9">@Model.FileName</dd>

            <dt class="col-sm-3">Tipo</dt>
            <dd class="col-sm-9">@Model.FileType</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>

            <dt class="col-sm-3">Importado em</dt>
            <dd class="col-sm-9">@Model.ImportedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-3">Erro</dt>
            <dd class="col-sm-9">
                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <span class="text-danger">@Model.ErrorMessage</span>
                }
                else
                {
                    <span class="text-muted">Nenhum erro registrado.</span>
                }
            </dd>

            <dt class="col-sm-3">Linhas detectadas</dt>
            <dd class="col-sm-9">@totalLines</dd>
        </dl>
    </div>
</div>

@if (normalizedStatus == PrintImportStatus.Error && !string.IsNullOrWhiteSpace(processImportHint))
{
    <div class="alert @(canProcessImport ? "alert-warning" : "alert-secondary") mb-4">
        @processImportHint
    </div>
}

@if (!string.IsNullOrWhiteSpace(Model.ParsedDataJson))
{
    <h2>Dados interpretados</h2>

    <p class="text-muted">
        Resultado do parser aplicado ao arquivo importado.
    </p>

    <pre class="bg-light border rounded p-3" style="max-height: 400px; overflow: auto;"><code>@Model.ParsedDataJson</code></pre>
}

<h2>Prévia do conteúdo bruto</h2>

<p class="text-muted">
    Mostrando até 120 linhas do arquivo. O conteúdo completo está salvo no banco.
</p>

<pre class="bg-light border rounded p-3" style="max-height: 500px; overflow: auto;"><code>@string.Join('\n', rawLines)</code></pre>

<div class="mt-3 d-flex gap-2">
    @if (canProcessImport)
    {
        <form asp-action="Process" asp-route-id="@Model.Id" method="post" class="m-0">
            @Html.AntiForgeryToken()
            @if (!string.IsNullOrWhiteSpace(returnTo))
            {
                <input type="hidden" name="returnTo" value="@returnTo" />
            }
            <button type="submit" class="btn btn-primary">
                @(normalizedStatus == PrintImportStatus.Error ? "Tentar processar novamente" : "Processar arquivo")
            </button>
        </form>
    }

    @if (linkedPrintJobId is not null)
    {
        <a asp-controller="PrintJobs"
           asp-action="Details"
           asp-route-id="@linkedPrintJobId.Value"
           asp-route-returnTo="@returnTo"
           class="btn btn-success">Ver produção vinculada</a>
    }
    else if (normalizedStatus == PrintImportStatus.Parsed && !string.IsNullOrWhiteSpace(Model.ParsedDataJson))
    {
        <a asp-action="CreatePrintJob" asp-route-id="@Model.Id" asp-route-returnTo="@returnTo" class="btn btn-success">Gerar produção</a>
    }

    @if (returnTo == "errorQueue")
    {
        <a asp-action="Index" asp-route-status="error" class="btn btn-outline-secondary">Voltar para falhas</a>
    }
    else if (returnTo == "pendingQueue")
    {
        <a asp-action="Index" asp-route-productionState="pending" class="btn btn-outline-secondary">Voltar para pendentes</a>
    }
    else
    {
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
    }
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Remover</a>
</div>
