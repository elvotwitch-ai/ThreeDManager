@model ThreeDManager.Domain.Entities.Product
@using ThreeDManager.Domain.Entities

@{
    ViewData["Title"] = "Detalhes do produto";
    var stockMovements = ViewBag.StockMovements as List<ProductStockMovement> ?? new List<ProductStockMovement>();
}

<div class="mb-4">
    <h1 class="mb-1">@Model.Name</h1>
    <p class="text-muted mb-0">Detalhes do produto cadastrado.</p>
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">ID</dt>
            <dd class="col-sm-9">@Model.Id</dd>

            <dt class="col-sm-3">Nome</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">SKU</dt>
            <dd class="col-sm-9">@(Model.Sku ?? "-")</dd>

            <dt class="col-sm-3">Categoria</dt>
            <dd class="col-sm-9">@(Model.Category ?? "-")</dd>

            <dt class="col-sm-3">Preço de venda</dt>
            <dd class="col-sm-9">
                @if (Model.SalePrice.HasValue)
                {
                    <span>@Model.SalePrice.Value.ToString("C")</span>
                }
                else
                {
                    <span class="text-muted">Não informado</span>
                }
            </dd>

            <dt class="col-sm-3">Estoque de produtos acabados</dt>
            <dd class="col-sm-9">
                @if (Model.StockQuantity.HasValue)
                {
                    <span>@Model.StockQuantity.Value un.</span>
                }
                else
                {
                    <span class="text-muted">Não informado</span>
                }
            </dd>

            <dt class="col-sm-3">Estoque mínimo</dt>
            <dd class="col-sm-9">
                @if (Model.MinimumStockQuantity.HasValue)
                {
                    <span>@Model.MinimumStockQuantity.Value un.</span>
                }
                else
                {
                    <span class="text-muted">Não definido</span>
                }
            </dd>

            <dt class="col-sm-3">Margem alvo</dt>
            <dd class="col-sm-9">
                @if (Model.TargetMarginPercentage.HasValue)
                {
                    <span>@Model.TargetMarginPercentage.Value.ToString("N1")%</span>
                }
                else
                {
                    <span class="text-muted">Não definida</span>
                }
            </dd>

            <dt class="col-sm-3">Custo padrão de embalagem</dt>
            <dd class="col-sm-9">
                @if (Model.DefaultPackagingCost.HasValue)
                {
                    <span>@Model.DefaultPackagingCost.Value.ToString("C")</span>
                }
                else
                {
                    <span class="text-muted">Não definido</span>
                }
            </dd>

            <dt class="col-sm-3">Status estoque</dt>
            <dd class="col-sm-9">
                @{
                    var hasStockQuantity = Model.StockQuantity.HasValue;
                    var hasMinimumStockQuantity = Model.MinimumStockQuantity.HasValue;
                    var isLowStockQuantity = hasStockQuantity
                        && hasMinimumStockQuantity
                        && Model.StockQuantity!.Value <= Model.MinimumStockQuantity!.Value;
                }

                @if (isLowStockQuantity)
                {
                    <span class="badge bg-danger">Baixo estoque</span>
                }
                else if (hasStockQuantity && hasMinimumStockQuantity)
                {
                    <span class="badge bg-success">Ok</span>
                }
                else
                {
                    <span class="badge bg-secondary">Sem alerta</span>
                }
            </dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">Ativo</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inativo</span>
                }
            </dd>

            <dt class="col-sm-3">Criado em</dt>
            <dd class="col-sm-9">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>

            <dt class="col-sm-3">Descrição</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</dd>
        </dl>
    </div>
</div>

<div class="mt-4">
    <h2 class="h4 mb-3">Movimentações de estoque</h2>

    @if (!stockMovements.Any())
    {
        <div class="alert alert-info">Nenhuma movimentação de estoque registrada para este produto.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Tipo</th>
                        <th>Quantidade</th>
                        <th>Antes</th>
                        <th>Depois</th>
                        <th>Observações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var movement in stockMovements)
                    {
                        var movementLabel = movement.MovementType switch
                        {
                            "PrintJobCompleted" => "Crédito automático",
                            "PrintJobStockCreditReverted" => "Reversão automática",
                            "ManualAdjustment" => "Ajuste manual",
                            _ => movement.MovementType
                        };

                        <tr>
                            <td>@movement.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@movementLabel</td>
                            <td class="@(movement.QuantityUnits < 0 ? "text-danger" : "text-success")">
                                @if (movement.QuantityUnits > 0)
                                {
                                    <text>+</text>
                                }
                                @movement.QuantityUnits<text> un.</text>
                            </td>
                            <td>
                                @if (movement.StockBeforeUnits.HasValue)
                                {
                                    @movement.StockBeforeUnits.Value<text> un.</text>
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </td>
                            <td>
                                @if (movement.StockAfterUnits.HasValue)
                                {
                                    @movement.StockAfterUnits.Value<text> un.</text>
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </td>
                            <td>@(movement.Notes ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="mt-3 d-flex gap-2">
    <a asp-action="AdjustStock" asp-route-id="@Model.Id" class="btn btn-success">Ajustar estoque</a>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Remover</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
</div>
