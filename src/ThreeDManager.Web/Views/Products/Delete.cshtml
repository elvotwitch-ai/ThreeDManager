@model ThreeDManager.Domain.Entities.Product

@{
    ViewData["Title"] = "Remover produto";
    var returnTo = ViewData["ReturnTo"] as string;
}

<div class="mb-4">
    <h1 class="mb-1">Remover produto</h1>
    <p class="text-muted mb-0">Confirme a exclusão somente se tiver certeza.</p>
</div>

<div class="alert alert-warning" role="alert">
    Tem certeza que deseja remover este produto? Esta ação não deve ser usada para produtos que já possuem histórico de produção.
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Nome</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">SKU</dt>
            <dd class="col-sm-9">@(Model.Sku ?? "-")</dd>

            <dt class="col-sm-3">Categoria</dt>
            <dd class="col-sm-9">@(Model.Category ?? "-")</dd>

            <dt class="col-sm-3">Preço de venda</dt>
            <dd class="col-sm-9">
                @if (Model.SalePrice.HasValue)
                {
                    <span>@Model.SalePrice.Value.ToString("C")</span>
                }
                else
                {
                    <span class="text-muted">Não informado</span>
                }
            </dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success">Ativo</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inativo</span>
                }
            </dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="Id" />
    @if (!string.IsNullOrWhiteSpace(returnTo))
    {
        <input type="hidden" name="returnTo" value="@returnTo" />
    }

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">Confirmar remoção</button>
        <a asp-action="Details" asp-route-id="@Model.Id" asp-route-returnTo="@returnTo" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>
