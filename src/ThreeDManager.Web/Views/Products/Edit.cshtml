@model ThreeDManager.Domain.Entities.Product

@{
    ViewData["Title"] = "Editar produto";
}

<div class="mb-4">
    <h1 class="mb-1">Editar produto</h1>
    <p class="text-muted mb-0">Atualize as informações cadastradas.</p>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Nome</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Sku" class="form-label">SKU</label>
                <input asp-for="Sku" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Category" class="form-label">Categoria</label>
                <input asp-for="Category" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="SalePrice" class="form-label">Preço de venda</label>
                <input asp-for="SalePrice" class="form-control" type="number" step="0.01" min="0" />
            </div>

            <div class="mb-3">
                <label asp-for="StockQuantity" class="form-label">Estoque de produtos acabados</label>
                <input asp-for="StockQuantity" class="form-control" type="number" step="1" min="0" />
                <span asp-validation-for="StockQuantity" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MinimumStockQuantity" class="form-label">Estoque mínimo</label>
                <input asp-for="MinimumStockQuantity" class="form-control" type="number" step="1" min="0" />
                <span asp-validation-for="MinimumStockQuantity" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TargetMarginPercentage" class="form-label">Margem alvo (%)</label>
                <input asp-for="TargetMarginPercentage" class="form-control" type="number" step="0.1" min="0" placeholder="Ex: 50" />
                <span asp-validation-for="TargetMarginPercentage" class="text-danger"></span>
                <div class="form-text">Margem de lucro desejada sobre o custo total de produção, usada para sugerir o preço de venda.</div>
            </div>

            <div class="mb-3">
                <label asp-for="DefaultPackagingCost" class="form-label">Custo padrão de embalagem (R$)</label>
                <input asp-for="DefaultPackagingCost" class="form-control" type="number" step="0.01" min="0" placeholder="Ex: 2.50" />
                <span asp-validation-for="DefaultPackagingCost" class="text-danger"></span>
                <div class="form-text">Usado para preencher automaticamente o custo de embalagem ao gerar uma produção a partir de uma importação.</div>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Descrição</label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            </div>

            <div class="form-check mb-3">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Produto ativo</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Salvar alterações</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
