@model IEnumerable<ThreeDManager.Domain.Entities.Product>
@using ThreeDManager.Domain.Entities

@{
    ViewData["Title"] = "Produtos";
    var latestStockMovements = ViewBag.LatestStockMovements as Dictionary<Guid, ProductStockMovement> ?? new Dictionary<Guid, ProductStockMovement>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Produtos</h1>
        <p class="text-muted mb-0">Cadastro de produtos comerciais do ThreeDManager.</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">Novo produto</a>
</div>

@if (TempData["SuccessMessage"] is not null)
{
    <div class="alert alert-success" role="alert">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] is not null)
{
    <div class="alert alert-danger" role="alert">
        @TempData["ErrorMessage"]
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        Nenhum produto cadastrado ainda. Clique em "Novo produto" para começar.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>SKU</th>
                    <th>Categoria</th>
                    <th>Preço de venda</th>
                    <th>Estoque</th>
                    <th>Estoque mínimo</th>
                    <th>Status estoque</th>
                    <th>Margem alvo</th>
                    <th>Custo padrão de embalagem</th>
                    <th>Movimentação recente</th>
                    <th>Status</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    latestStockMovements.TryGetValue(product.Id, out var latestMovement);
                    var movementLabel = latestMovement?.MovementType switch
                    {
                        "PrintJobCompleted" => "Crédito automático",
                        "PrintJobStockCreditReverted" => "Reversão automática",
                        "ManualAdjustment" => "Ajuste manual",
                        _ => latestMovement?.MovementType
                    };

                    <tr>
                        <td class="fw-semibold">@product.Name</td>
                        <td>@(product.Sku ?? "-")</td>
                        <td>@(product.Category ?? "-")</td>
                        <td>
                            @if (product.SalePrice.HasValue)
                            {
                                <span>@product.SalePrice.Value.ToString("C")</span>
                            }
                            else
                            {
                                <span class="badge text-bg-light">Não informado</span>
                            }
                        </td>
                        <td>
                            @if (product.StockQuantity.HasValue)
                            {
                                <span>@product.StockQuantity.Value un.</span>
                            }
                            else
                            {
                                <span class="badge text-bg-light">Não informado</span>
                            }
                        </td>
                        <td>
                            @if (product.MinimumStockQuantity.HasValue)
                            {
                                <span>@product.MinimumStockQuantity.Value un.</span>
                            }
                            else
                            {
                                <span class="text-muted">Não definido</span>
                            }
                        </td>
                        <td>
                            @{
                                var hasStockQuantity = product.StockQuantity.HasValue;
                                var hasMinimumStockQuantity = product.MinimumStockQuantity.HasValue;
                                var isLowStockQuantity = hasStockQuantity
                                    && hasMinimumStockQuantity
                                    && product.StockQuantity!.Value <= product.MinimumStockQuantity!.Value;
                            }

                            @if (isLowStockQuantity)
                            {
                                <span class="badge bg-danger">Baixo estoque</span>
                            }
                            else if (hasStockQuantity && hasMinimumStockQuantity)
                            {
                                <span class="badge bg-success">Ok</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Sem alerta</span>
                            }
                        </td>
                        <td>
                            @if (product.TargetMarginPercentage.HasValue)
                            {
                                <span>@product.TargetMarginPercentage.Value.ToString("N1")%</span>
                            }
                            else
                            {
                                <span class="text-muted">Não definida</span>
                            }
                        </td>
                        <td>
                            @if (product.DefaultPackagingCost.HasValue)
                            {
                                <span>@product.DefaultPackagingCost.Value.ToString("C")</span>
                            }
                            else
                            {
                                <span class="text-muted">Não definido</span>
                            }
                        </td>
                        <td>
                            @if (latestMovement is null)
                            {
                                <span class="badge text-bg-light">Sem histórico</span>
                            }
                            else
                            {
                                <div class="small fw-semibold @(latestMovement.QuantityUnits < 0 ? "text-danger" : "text-success")">
                                    @(latestMovement.QuantityUnits > 0 ? "+" : string.Empty)@latestMovement.QuantityUnits un.
                                </div>
                                <div class="small text-muted">
                                    @movementLabel
                                    @if (latestMovement.CreatedAt != default)
                                    {
                                        <span>• @latestMovement.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(latestMovement.Notes))
                                {
                                    <div class="small text-muted">@latestMovement.Notes</div>
                                }
                            }
                        </td>
                        <td>
                            @if (product.IsActive)
                            {
                                <span class="badge bg-success">Ativo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inativo</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-1">
                                <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary">Detalhes</a>
                                <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                <a asp-action="AdjustStock" asp-route-id="@product.Id" class="btn btn-sm btn-outline-success">Estoque</a>
                                <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger">Remover</a>

                                @if (product.IsActive)
                                {
                                    <form asp-action="Deactivate" asp-route-id="@product.Id" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Desativar</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Activate" asp-route-id="@product.Id" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-success">Ativar</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
